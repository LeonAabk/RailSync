rules_version = '2';

// RailSync – sikkerhetsregler for Cloud Firestore
// Lim inn i Firebase-konsollen: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // -------------------------------------------------------------------
    // Private brukerdata (personlige budsjetter, venneliste) – kun eieren
    // -------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isSelf(userId);
    }

    // -------------------------------------------------------------------
    // Offentlige profiler – kan søkes opp av innloggede reisende
    // -------------------------------------------------------------------
    function validPublicProfile(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'displayName', 'username', 'avatarColor', 'homeStation', 'bio',
                               'visitedCountries', 'visitedPlaces', 'wishlistPlaces',
                               'searchNameLower', 'searchUsernameLower', 'updatedAt', 'photo'])
        && d.uid == userId
        && d.displayName is string && d.displayName.size() <= 60
        && d.username is string && d.username.size() <= 30
        && d.username.matches('^@[a-z0-9][a-z0-9._-]{0,28}$')
        && get(/databases/$(database)/documents/usernames/$(d.username[1:d.username.size()])).data.uid == userId
        && d.avatarColor is string && d.avatarColor.matches('^#[0-9a-fA-F]{6}$')
        && (!('homeStation' in d) || (d.homeStation is string && d.homeStation.size() <= 80))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 300))
        && (!('visitedCountries' in d) || (d.visitedCountries is list && d.visitedCountries.size() <= 60))
        && (!('visitedPlaces' in d) || (d.visitedPlaces is list && d.visitedPlaces.size() <= 100))
        && (!('wishlistPlaces' in d) || (d.wishlistPlaces is list && d.wishlistPlaces.size() <= 100))
        && (!('photo' in d) || validJpegDataUrl(d.photo, 60000));
    }

    // Bilder lagres som JPEG-data-URL. Tom streng betyr "ingen bilde".
    function validJpegDataUrl(v, maxSize) {
      return v is string
        && (v == '' || (v.size() <= maxSize && v.size() > 23 && v[0:23] == 'data:image/jpeg;base64,'));
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId) && validPublicProfile(userId);
      allow delete: if isSelf(userId);
    }

    // -------------------------------------------------------------------
    // Unike brukernavn – dokument-ID er brukernavnet uten @
    // Alle kan sjekke om et navn er ledig, bare eieren kan slippe det.
    // -------------------------------------------------------------------
    match /usernames/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && handle.matches('^[a-z0-9][a-z0-9._-]{0,28}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------------
    // Bakgrunnsbilde – eget dokument så profilsøk forblir raskt
    // -------------------------------------------------------------------
    match /profileMedia/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['cover', 'updatedAt'])
        && validJpegDataUrl(request.resource.data.cover, 320000);
      allow delete: if isSelf(userId);
    }

    // -------------------------------------------------------------------
    // Venneforespørsler og vennskap – dokument-ID er "{fra}_{til}".
    // status 'accepted' = venner. Begge kan slette (fjerne venn / avslå / trekke tilbake).
    // -------------------------------------------------------------------
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'createdAt', 'fromProfile']);

      // Bare mottakeren kan godta
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && changedKeys().hasOnly(['status', 'acceptedAt', 'toProfile']);

      // Avsender kan trekke tilbake, mottaker kan avslå
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // -------------------------------------------------------------------
    // Reiser
    // -------------------------------------------------------------------
    function isTripOwner() {
      return signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function isTripMember() {
      return signedIn() && request.auth.uid in resource.data.get('memberUids', []);
    }

    function isTripEditor() {
      return signedIn() && request.auth.uid in resource.data.get('editorUids', []);
    }

    // Felt som bare eieren kan endre
    function protectedTripKeys() {
      return ['ownerUid', 'owner', 'memberUids', 'editorUids', 'members', 'visibility', 'sharePermission', 'shareCode'];
    }

    // Innlogget bruker blir med i en delt reise via lenke/kode
    function isJoiningSharedTrip() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let oldEditors = before.get('editorUids', []);
      return signedIn()
        && before.get('visibility', 'private') == 'shared'
        && !(uid in before.get('memberUids', []))
        && changedKeys().hasOnly(['memberUids', 'editorUids', 'members', 'updatedAt'])
        && after.memberUids == before.get('memberUids', []).concat([uid])
        && (after.get('editorUids', []) == oldEditors
            || (before.get('sharePermission', 'edit') == 'edit' && after.editorUids == oldEditors.concat([uid])))
        && after.members.size() == before.get('members', []).size() + 1;
    }

    // Medlem forlater reisen
    function isLeavingTrip() {
      let uid = request.auth.uid;
      return isTripMember()
        && !isTripOwner()
        && changedKeys().hasOnly(['memberUids', 'editorUids', 'members', 'updatedAt'])
        && request.resource.data.memberUids == resource.data.memberUids.removeAll([uid])
        && request.resource.data.get('editorUids', []) == resource.data.get('editorUids', []).removeAll([uid]);
    }

    function validBudget(budgetUid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'totalBudget', 'expenses', 'updatedAt'])
        && d.uid == budgetUid
        && d.totalBudget is number && d.totalBudget >= 0 && d.totalBudget <= 10000000
        && d.expenses is list && d.expenses.size() <= 500
        && (!('name' in d) || (d.name is string && d.name.size() <= 60));
    }

    function validSharedExpense(expenseId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'kind', 'title', 'category', 'amount', 'date', 'paidBy', 'split', 'names',
                               'createdBy', 'createdAt', 'updatedAt'])
        && d.id == expenseId
        && d.kind in ['expense', 'payment']
        && d.title is string && d.title.size() <= 80
        && d.amount is number && d.amount > 0 && d.amount <= 1000000
        && d.paidBy is string && d.paidBy.size() <= 80
        && d.split is list && d.split.size() >= 1 && d.split.size() <= 30
        && d.date is string && d.date.size() <= 10
        && d.names is map && d.names.size() <= 31
        && (!('category' in d) || (d.category is string && d.category.size() <= 30));
    }

    match /trips/{tripId} {
      // Enkeltreise: eier, medlem, eller delt reise for innloggede som har lenken/koden
      allow get: if isTripOwner() || isTripMember()
        || (signedIn() && resource.data.get('visibility', 'private') == 'shared');

      // Lister/søk: bare egne reiser og reiser man er medlem av
      allow list: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.memberUids);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && !('expenses' in request.resource.data);

      allow update: if !('expenses' in request.resource.data) && (
        (isTripOwner() && request.resource.data.ownerUid == resource.data.ownerUid)
        || (isTripEditor() && !changedKeys().hasAny(protectedTripKeys()))
        || isJoiningSharedTrip()
        || isLeavingTrip()
      );

      allow delete: if isTripOwner();

      // Reisen sett fra en underside (budsjetter og felles utgifter)
      function tripDoc() {
        return get(/databases/$(database)/documents/trips/$(tripId)).data;
      }
      function inTrip() {
        let t = tripDoc();
        return signedIn() && (t.get('ownerUid', '') == request.auth.uid || request.auth.uid in t.get('memberUids', []));
      }
      function ownsTripDoc() {
        return signedIn() && tripDoc().get('ownerUid', '') == request.auth.uid;
      }

      // Hver persons budsjett: alle i reisefølget kan se, bare personen selv kan endre
      match /budgets/{budgetUid} {
        allow read: if inTrip();
        allow create, update: if inTrip() && request.auth.uid == budgetUid && validBudget(budgetUid);
        allow delete: if signedIn() && (request.auth.uid == budgetUid || ownsTripDoc());
      }

      // Felles utgifter: alle i reisefølget kan legge til, den som la inn (eller eieren) kan endre/slette
      match /sharedExpenses/{expenseId} {
        allow read: if inTrip();
        allow create: if inTrip() && request.resource.data.createdBy == request.auth.uid && validSharedExpense(expenseId);
        allow update: if inTrip()
          && (resource.data.createdBy == request.auth.uid || ownsTripDoc())
          && request.resource.data.createdBy == resource.data.createdBy
          && validSharedExpense(expenseId);
        allow delete: if (inTrip() && resource.data.createdBy == request.auth.uid) || ownsTripDoc();
      }
    }

    // -------------------------------------------------------------------
    // Delingskoder (RS-XXXX-XXXX) → reise-ID. Kan slås opp, ikke listes.
    // -------------------------------------------------------------------
    match /shareCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
