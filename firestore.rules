rules_version = '2';

// RailSync – sikkerhetsregler for Cloud Firestore
// Lim inn i Firebase-konsollen: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // -------------------------------------------------------------------
    // Private brukerdata (personlige budsjetter, venneliste) – kun eieren
    // -------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isSelf(userId);
    }

    // -------------------------------------------------------------------
    // Offentlige profiler – kan søkes opp av innloggede reisende
    // -------------------------------------------------------------------
    function validPublicProfile(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'displayName', 'username', 'avatarColor', 'homeStation', 'bio',
                               'visitedCountries', 'visitedPlaces', 'wishlistPlaces',
                               'searchNameLower', 'searchUsernameLower', 'updatedAt'])
        && d.uid == userId
        && d.displayName is string && d.displayName.size() <= 60
        && d.username is string && d.username.size() <= 30
        && d.avatarColor is string && d.avatarColor.matches('^#[0-9a-fA-F]{6}$')
        && (!('homeStation' in d) || (d.homeStation is string && d.homeStation.size() <= 80))
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 300))
        && (!('visitedCountries' in d) || (d.visitedCountries is list && d.visitedCountries.size() <= 60))
        && (!('visitedPlaces' in d) || (d.visitedPlaces is list && d.visitedPlaces.size() <= 100))
        && (!('wishlistPlaces' in d) || (d.wishlistPlaces is list && d.wishlistPlaces.size() <= 100));
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId) && validPublicProfile(userId);
      allow delete: if isSelf(userId);
    }

    // -------------------------------------------------------------------
    // Venneforespørsler – dokument-ID er "{fra}_{til}"
    // -------------------------------------------------------------------
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'createdAt', 'fromProfile']);

      // Bare mottakeren kan godta
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && changedKeys().hasOnly(['status', 'acceptedAt', 'toProfile']);

      // Avsender kan trekke tilbake, mottaker kan avslå
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // -------------------------------------------------------------------
    // Reiser
    // -------------------------------------------------------------------
    function isTripOwner() {
      return signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function isTripMember() {
      return signedIn() && request.auth.uid in resource.data.get('memberUids', []);
    }

    function isTripEditor() {
      return signedIn() && request.auth.uid in resource.data.get('editorUids', []);
    }

    // Felt som bare eieren kan endre
    function protectedTripKeys() {
      return ['ownerUid', 'owner', 'memberUids', 'editorUids', 'members', 'visibility', 'sharePermission', 'shareCode'];
    }

    // Innlogget bruker blir med i en delt reise via lenke/kode
    function isJoiningSharedTrip() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let oldEditors = before.get('editorUids', []);
      return signedIn()
        && before.get('visibility', 'private') == 'shared'
        && !(uid in before.get('memberUids', []))
        && changedKeys().hasOnly(['memberUids', 'editorUids', 'members', 'updatedAt'])
        && after.memberUids == before.get('memberUids', []).concat([uid])
        && (after.get('editorUids', []) == oldEditors
            || (before.get('sharePermission', 'edit') == 'edit' && after.editorUids == oldEditors.concat([uid])))
        && after.members.size() == before.get('members', []).size() + 1;
    }

    // Medlem forlater reisen
    function isLeavingTrip() {
      let uid = request.auth.uid;
      return isTripMember()
        && !isTripOwner()
        && changedKeys().hasOnly(['memberUids', 'editorUids', 'members', 'updatedAt'])
        && request.resource.data.memberUids == resource.data.memberUids.removeAll([uid])
        && request.resource.data.get('editorUids', []) == resource.data.get('editorUids', []).removeAll([uid]);
    }

    match /trips/{tripId} {
      // Enkeltreise: eier, medlem, eller delt reise for innloggede som har lenken/koden
      allow get: if isTripOwner() || isTripMember()
        || (signedIn() && resource.data.get('visibility', 'private') == 'shared');

      // Lister/søk: bare egne reiser og reiser man er medlem av
      allow list: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.memberUids);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && !('expenses' in request.resource.data);

      allow update: if !('expenses' in request.resource.data) && (
        (isTripOwner() && request.resource.data.ownerUid == resource.data.ownerUid)
        || (isTripEditor() && !changedKeys().hasAny(protectedTripKeys()))
        || isJoiningSharedTrip()
        || isLeavingTrip()
      );

      allow delete: if isTripOwner();
    }

    // -------------------------------------------------------------------
    // Delingskoder (RS-XXXX-XXXX) → reise-ID. Kan slås opp, ikke listes.
    // -------------------------------------------------------------------
    match /shareCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
